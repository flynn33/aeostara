{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RollbackPlan",
  "description": "Deterministic rollback plan used when execution verification fails or policy requires rollback.",
  "type": "object",
  "properties": {
    "rollbackPlanID": {
      "type": "string"
    },
    "recoveryPlanID": {
      "type": "string"
    },
    "backupReference": {
      "type": "string"
    },
    "restoreTargets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "rollbackReason": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["rollbackPlanID", "recoveryPlanID", "backupReference", "restoreTargets", "rollbackReason", "createdAt"],
  "additionalProperties": false
}
