{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InvariantLegacy",
  "description": "Legacy policy expression artifact retained for execution policy gates only. Not a substitute for ASH validity semantics.",
  "x-status": "legacy-non-authoritative",
  "x-replacement": "StateValidityDiagnostic.schema.json",
  "type": "object",
  "properties": {
    "invariantID": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["Low", "Medium", "High", "Critical"],
      "default": "Medium"
    },
    "expression": {
      "type": "string"
    },
    "appliesTo": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "autoRemediate": {
      "type": "boolean",
      "default": false
    },
    "deprecatedSince": {
      "type": "string",
      "format": "date"
    }
  },
  "required": ["invariantID", "name", "expression"],
  "additionalProperties": false
}
