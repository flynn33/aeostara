{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PolicyConstraint",
  "description": "Authoritative downstream policy-gate constraint contract built under the ASH Pattern System. Constraints govern execution gates while ASH supplies validity/admissibility semantics.",
  "x-ash-role": "authoritative-downstream-policy-constraint",
  "x-upstream-contract": "StateValidityDiagnostic.schema.json",
  "type": "object",
  "properties": {
    "invariantID": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "default": "medium"
    },
    "expression": {
      "type": "string"
    },
    "appliesTo": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "autoRemediate": {
      "type": "boolean",
      "default": false
    },
    "ashBinding": {
      "type": "object",
      "properties": {
        "policyGateID": {
          "type": "string"
        },
        "diagnosticDimension": {
          "type": "string"
        }
      },
      "required": ["policyGateID", "diagnosticDimension"],
      "additionalProperties": false
    }
  },
  "required": ["invariantID", "name", "expression", "ashBinding"],
  "additionalProperties": false
}
