{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DesiredStateAdapter",
  "description": "Authoritative downstream desired-state adapter contract built under the ASH Pattern System. It captures intent-loading mechanics and projects into DesiredSystemIntent before ASH semantic evaluation.",
  "x-ash-role": "authoritative-downstream-intent",
  "x-upstream-contract": "DesiredSystemIntent.schema.json",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": true
    },
    "source": {
      "type": "string"
    },
    "declaredAt": {
      "type": "string",
      "format": "date-time"
    },
    "ashIntentProjection": {
      "type": "object",
      "properties": {
        "intentID": {
          "type": "string"
        },
        "intentSource": {
          "type": "string"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["intentID", "intentSource"],
      "additionalProperties": false
    }
  },
  "required": ["data", "source", "declaredAt", "ashIntentProjection"],
  "additionalProperties": false
}
