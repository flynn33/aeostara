{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SemanticDimensionBinding",
  "description": "Binding from source evidence to one ASH coordinate.",
  "type": "object",
  "properties": {
    "dimensionID": {
      "type": "string",
      "enum": [
        "b0",
        "b1",
        "b2",
        "b3",
        "b4",
        "b5",
        "b6",
        "b7",
        "b8"
      ]
    },
    "sourcePointers": {
      "type": "array",
      "items": {
        "$ref": "JsonPointer.schema.json"
      },
      "minItems": 1
    },
    "mappingRule": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "minItems": 1
    },
    "diagnosticReference": {
      "$ref": "DiagnosticReference.schema.json"
    }
  },
  "required": [
    "dimensionID",
    "sourcePointers",
    "mappingRule",
    "evidence",
    "diagnosticReference"
  ],
  "additionalProperties": false
}
