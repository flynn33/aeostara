{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AshSemanticState",
  "description": "ASH-aligned semantic state record produced from normalized observed state and desired intent mapping.",
  "type": "object",
  "properties": {
    "semanticStateID": {
      "type": "string"
    },
    "ashStateVector": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "integer",
        "enum": [0, 1]
      }
    },
    "admissibilityStatus": {
      "type": "string",
      "enum": ["VALID", "TRANSFORMATION_COMPATIBLE", "TRANSFORMATION_INCOMPATIBLE", "UNCLASSIFIED"]
    },
    "transformationCompatibility": {
      "type": "string",
      "enum": ["COMPATIBLE", "INCOMPATIBLE", "UNKNOWN"]
    },
    "normalizationStatus": {
      "type": "string",
      "enum": ["ALREADY_VALID", "NORMALIZABLE", "NOT_NORMALIZABLE", "BLOCKED"]
    },
    "orbitInfo": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "sourceObservationID": {
      "type": "string"
    },
    "sourceIntentID": {
      "type": "string"
    }
  },
  "required": ["semanticStateID", "ashStateVector", "admissibilityStatus", "transformationCompatibility", "normalizationStatus", "sourceObservationID", "sourceIntentID"],
  "additionalProperties": false
}
