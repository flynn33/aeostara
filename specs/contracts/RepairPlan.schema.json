{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepairPlanLegacy",
  "description": "Deprecated diff-first planning artifact. Retained for compatibility only. Semantic authority moved to RecoveryPlan.",
  "x-status": "legacy-non-authoritative",
  "x-replacement": "RecoveryPlan.schema.json",
  "type": "object",
  "properties": {
    "planID": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "RepairAction.schema.json"
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "requiresBackup": {
      "type": "boolean"
    },
    "deprecatedSince": {
      "type": "string",
      "format": "date"
    }
  },
  "required": ["planID", "actions", "timestamp", "requiresBackup"],
  "additionalProperties": false
}
