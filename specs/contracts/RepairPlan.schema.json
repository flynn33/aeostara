{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepairPlan",
  "description": "Actuator projection subordinate to RecoveryPlan.",
  "type": "object",
  "properties": {
    "repairPlanID": {
      "type": "string"
    },
    "recoveryPlan": {
      "$ref": "RecoveryPlan.schema.json"
    },
    "repairActions": {
      "type": "array",
      "items": {
        "$ref": "RepairAction.schema.json"
      },
      "minItems": 0
    }
  },
  "required": [
    "repairPlanID",
    "recoveryPlan",
    "repairActions"
  ],
  "additionalProperties": false
}
