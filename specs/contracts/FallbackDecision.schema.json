{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FallbackDecision",
  "description": "Fallback decision traceable to registry and diagnostics.",
  "type": "object",
  "properties": {
    "fallbackDecisionID": {
      "type": "string"
    },
    "registryReference": {
      "type": "string"
    },
    "selectedCandidateID": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "SELECTED",
        "UNAVAILABLE",
        "BLOCKED"
      ]
    },
    "diagnosticReference": {
      "$ref": "DiagnosticReference.schema.json"
    }
  },
  "required": [
    "fallbackDecisionID",
    "registryReference",
    "selectedCandidateID",
    "status",
    "diagnosticReference"
  ],
  "additionalProperties": false
}
