{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SemanticProjectionSpec",
  "description": "Declares JSON/config signals projected into ASH coordinates.",
  "type": "object",
  "properties": {
    "projectionSpecID": {
      "type": "string"
    },
    "dimensions": {
      "type": "array",
      "items": {
        "$ref": "SemanticDimensionBinding.schema.json"
      },
      "minItems": 9,
      "maxItems": 9
    },
    "version": {
      "type": "string"
    },
    "sourceReferences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "required": [
    "projectionSpecID",
    "dimensions",
    "version",
    "sourceReferences"
  ],
  "additionalProperties": false
}
