  "type": "object",
  "properties": {
    "encodedStateID": {
      "type": "string"
    },
    "encoding": {
      "type": "string"
    },
    "ashState": {
      "$ref": "AshState.schema.json"
    },
    "evidenceOnly": {
      "type": "boolean"
    }
  },
  "required": [
    "encodedStateID",
    "encoding",
    "ashState",
    "evidenceOnly"
  ],
  "additionalProperties": false
}
