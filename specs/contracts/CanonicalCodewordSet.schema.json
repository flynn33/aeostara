{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CanonicalCodewordSet",
  "description": "Fixed 16-codeword canonical ASH set.",
  "type": "object",
  "properties": {
    "codewordSetID": {
      "type": "string"
    },
    "codewords": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "minItems": 9,
        "maxItems": 9
      },
      "minItems": 16,
      "maxItems": 16
    },
    "sourceReference": {
      "type": "string"
    },
    "canonicalHash": {
      "type": "string"
    }
  },
  "required": [
    "codewordSetID",
    "codewords",
    "sourceReference",
    "canonicalHash"
  ],
  "additionalProperties": false
}
