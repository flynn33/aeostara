{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuleReference",
  "description": "ASH taxonomy-compliant rule reference.",
  "type": "object",
  "properties": {
    "ruleID": {
      "type": "string",
      "pattern": "^ASH-[A-Z]+-[A-Z]+-[0-9]{3}$"
    },
    "sourceReference": {
      "type": "string"
    },
    "ruleFamily": {
      "type": "string"
    }
  },
  "required": [
    "ruleID",
    "sourceReference",
    "ruleFamily"
  ],
  "additionalProperties": false
}
