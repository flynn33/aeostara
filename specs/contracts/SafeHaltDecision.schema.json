{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SafeHaltDecision",
  "description": "Terminal safe-halt decision.",
  "type": "object",
  "properties": {
    "safeHaltDecisionID": {
      "type": "string"
    },
    "terminal": {
      "type": "boolean",
      "const": true
    },
    "blockedTransitions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "diagnosticReference": {
      "$ref": "DiagnosticReference.schema.json"
    }
  },
  "required": [
    "safeHaltDecisionID",
    "terminal",
    "blockedTransitions",
    "diagnosticReference"
  ],
  "additionalProperties": false
}
