{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TransitionDefinition",
  "description": "Transition registry entry.",
  "type": "object",
  "properties": {
    "transitionID": {
      "type": "string"
    },
    "codewordReference": {
      "type": "string"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "diagnosticRules": {
      "type": "array",
      "items": {
        "$ref": "RuleReference.schema.json"
      },
      "minItems": 1
    }
  },
  "required": [
    "transitionID",
    "codewordReference",
    "preconditions",
    "diagnosticRules"
  ],
  "additionalProperties": false
}
