{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditEvent",
  "description": "Audit trail event for ASH-aligned diagnosis, recovery, fallback, containment, safe-halt, and execution mechanics.",
  "type": "object",
  "properties": {
    "eventID": {
      "type": "string"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "ObservationCaptured",
        "StateNormalized",
        "StateMappedToAsh",
        "DiagnosticEvaluated",
        "StateClassified",
        "RecoverabilityClassified",
        "RecoveryPlanGenerated",
        "PolicyGateBlocked",
        "BackupCreated",
        "ExecutionApplied",
        "VerificationSucceeded",
        "VerificationFailed",
        "RollbackExecuted",
        "FallbackSelected",
        "ContainmentEntered",
        "SafeHaltEntered",
        "EscalationRaised"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "subjectReference": {
      "type": "string"
    },
    "diagnosticKind": {
      "type": "string",
      "enum": ["STATE_VALIDITY", "RECOVERY", "FALLBACK", "CONTAINMENT", "SAFE_HALT"]
    },
    "ruleIDs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["eventID", "eventType", "timestamp", "subjectReference", "details"],
  "additionalProperties": false
}
