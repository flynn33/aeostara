{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BackupResult",
  "description": "Backup success/failure and escalation result.",
  "type": "object",
  "properties": {
    "backupResultID": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "SKIPPED"
      ]
    },
    "backupRecord": {
      "$ref": "BackupRecord.schema.json"
    },
    "escalationDecision": {
      "$ref": "EscalationDecision.schema.json"
    },
    "diagnosticReference": {
      "$ref": "DiagnosticReference.schema.json"
    }
  },
  "required": [
    "backupResultID",
    "status",
    "backupRecord",
    "diagnosticReference"
  ],
  "additionalProperties": false
}
