{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerificationResult",
  "description": "Post-execution verification result for ASH-aligned recovery outcomes.",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "verificationStage": {
      "type": "string",
      "enum": ["POST_EXECUTION", "POST_FALLBACK", "POST_CONTAINMENT_CHECK"]
    },
    "resultingSystemStateClass": {
      "type": "string",
      "enum": ["STABLE", "UNSTABLE", "CORRECTABLE", "DEGRADED", "CONTAINED", "FAILED", "SAFE_HALT"]
    },
    "failedChecks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ruleIDs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["success", "verifiedAt", "verificationStage", "resultingSystemStateClass", "failedChecks"],
  "additionalProperties": false
}
