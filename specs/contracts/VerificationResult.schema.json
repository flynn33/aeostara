{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerificationResult",
  "description": "Verification result paired with a verification plan.",
  "type": "object",
  "properties": {
    "verificationResultID": {
      "type": "string"
    },
    "verificationPlanID": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASSED",
        "FAILED",
        "BLOCKED"
      ]
    },
    "expectedSemanticState": {
      "$ref": "AshState.schema.json"
    },
    "actualSemanticState": {
      "$ref": "AshState.schema.json"
    },
    "diagnosticReference": {
      "$ref": "DiagnosticReference.schema.json"
    }
  },
  "required": [
    "verificationResultID",
    "verificationPlanID",
    "status",
    "expectedSemanticState",
    "actualSemanticState",
    "diagnosticReference"
  ],
  "additionalProperties": false
}
