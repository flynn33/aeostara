{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContainmentDecision",
  "description": "Containment boundary and restricted operations.",
  "type": "object",
  "properties": {
    "containmentDecisionID": {
      "type": "string"
    },
    "boundary": {
      "type": "object",
      "additionalProperties": true
    },
    "allowedOperations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "restrictedOperations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "diagnosticReference": {
      "$ref": "DiagnosticReference.schema.json"
    }
  },
  "required": [
    "containmentDecisionID",
    "boundary",
    "allowedOperations",
    "restrictedOperations",
    "diagnosticReference"
  ],
  "additionalProperties": false
}
