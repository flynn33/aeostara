{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RollbackResult",
  "description": "Rollback status and escalation.",
  "type": "object",
  "properties": {
    "rollbackResultID": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "NOT_REQUIRED"
      ]
    },
    "backupRecordID": {
      "type": "string"
    },
    "restoredHash": {
      "type": "string"
    },
    "escalationDecision": {
      "$ref": "EscalationDecision.schema.json"
    },
    "diagnosticReference": {
      "$ref": "DiagnosticReference.schema.json"
    }
  },
  "required": [
    "rollbackResultID",
    "status",
    "backupRecordID",
    "restoredHash",
    "diagnosticReference"
  ],
  "additionalProperties": false
}
