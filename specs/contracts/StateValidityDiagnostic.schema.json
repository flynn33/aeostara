{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StateValidityDiagnostic",
  "description": "State-validity diagnostic composing the diagnostic envelope.",
  "type": "object",
  "properties": {
    "stateValidityDiagnosticID": {
      "type": "string"
    },
    "diagnosticEnvelope": {
      "$ref": "DiagnosticEnvelope.schema.json"
    },
    "admissibilityStatus": {
      "type": "string",
      "enum": [
        "VALID",
        "TRANSFORMATION_COMPATIBLE",
        "TRANSFORMATION_INCOMPATIBLE",
        "UNCLASSIFIED"
      ]
    },
    "normalizationStatus": {
      "type": "string",
      "enum": [
        "ALREADY_VALID",
        "NORMALIZABLE",
        "NOT_NORMALIZABLE",
        "BLOCKED"
      ]
    },
    "recoverabilityRelevance": {
      "$ref": "RecoveryCategory.schema.json"
    }
  },
  "required": [
    "stateValidityDiagnosticID",
    "diagnosticEnvelope",
    "admissibilityStatus",
    "normalizationStatus",
    "recoverabilityRelevance"
  ],
  "additionalProperties": false
}
