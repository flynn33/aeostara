{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StateValidityDiagnostic",
  "description": "ASH-aligned diagnostic envelope for semantic state validity and recoverability relevance.",
  "type": "object",
  "properties": {
    "diagnosticID": {
      "type": "string"
    },
    "diagnosticKind": {
      "type": "string",
      "enum": ["STATE_VALIDITY", "RECOVERY", "FALLBACK", "CONTAINMENT", "SAFE_HALT"]
    },
    "severity": {
      "type": "string",
      "enum": ["INFO", "WARNING", "ERROR", "CRITICAL"]
    },
    "stage": {
      "type": "string",
      "enum": ["DETECTION", "CLASSIFICATION", "RECOVERY", "ESCALATION", "TERMINAL"]
    },
    "disposition": {
      "type": "string",
      "enum": ["RESOLVED", "PENDING", "BLOCKED", "ESCALATED", "TERMINAL"]
    },
    "subjectReference": {
      "type": "string"
    },
    "parentDiagnosticReference": {
      "type": ["string", "null"]
    },
    "chainRootReference": {
      "type": "string"
    },
    "ruleIDs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ASH-[A-Z]+-[A-Z]+-[0-9]{3}$"
      }
    },
    "summary": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "admissibilityStatus": {
      "type": "string",
      "enum": ["VALID", "TRANSFORMATION_COMPATIBLE", "TRANSFORMATION_INCOMPATIBLE", "UNCLASSIFIED"]
    },
    "transformationCompatibility": {
      "type": "string",
      "enum": ["COMPATIBLE", "INCOMPATIBLE", "UNKNOWN"]
    },
    "normalizationStatus": {
      "type": "string",
      "enum": ["ALREADY_VALID", "NORMALIZABLE", "NOT_NORMALIZABLE", "BLOCKED"]
    },
    "recoverabilityRelevance": {
      "type": "string",
      "enum": ["NO_RECOVERY_NEEDED", "RECOVERY_APPLICABLE", "FALLBACK_NEEDED", "CONTAINMENT_NEEDED", "NOT_RECOVERABLE"]
    },
    "isValid": {
      "type": "boolean"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "diagnosticID",
    "diagnosticKind",
    "severity",
    "stage",
    "disposition",
    "subjectReference",
    "chainRootReference",
    "ruleIDs",
    "summary",
    "notes",
    "admissibilityStatus",
    "transformationCompatibility",
    "normalizationStatus",
    "recoverabilityRelevance",
    "isValid",
    "generatedAt"
  ],
  "additionalProperties": false
}
