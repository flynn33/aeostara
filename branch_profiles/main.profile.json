{
  "profile": "main",
  "description": "Aeostara platform-agnostic base-design profile",
  "required_files": [
    "README.md",
    "REMEDIATION_STATUS.md",
    "BASE_DESIGN_COMPLETION.md",
    "ASH_BASELINE_REFERENCE.md",
    "specs/architecture/repository_role_contract.md",
    "ci/conformance_runner.py"
  ],
  "required_phrases": [
    {
      "file": "README.md",
      "phrase": "Aeostara is platform-agnostic"
    },
    {
      "file": "REMEDIATION_STATUS.md",
      "phrase": "ASH is the immutable upstream semantic authority"
    }
  ],
  "forbidden_patterns": [
    {
      "pattern": "legacy branch alignment completion scope",
      "paths": [
        "README.md",
        "REMEDIATION_STATUS.md",
        "specs/architecture"
      ]
    },
    {
      "pattern": "requires native .* source",
      "paths": [
        "README.md",
        "REMEDIATION_STATUS.md",
        "specs/architecture"
      ]
    }
  ],
  "required_globs": [
    {
      "pattern": "specs/contracts/*.schema.json",
      "min_count": 50
    },
    {
      "pattern": "fixtures/conformance/*.json",
      "min_count": 10
    }
  ],
  "forbidden_globs": [
    {
      "pattern": "PHASE_5_CLOSEOUT.md"
    },
    {
      "pattern": "specs/architecture/repo_branch_drift_matrix.md"
    }
  ]
}
